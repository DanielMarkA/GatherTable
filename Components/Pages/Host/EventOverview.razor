@page "/events/studio-team-dinner"
@page "/events/studio-team-dinner/overview"
@page "/events/{id}"
@inject NavigationManager Navigation
@inject DiningCoordinatorService DiningService
@inject IJSRuntime JS
@implements IDisposable

@{
    var ev = DiningService.CurrentEvent;
    var fin = DiningService.CalculateFinances();
    var confirmedGuests = ev.Guests.Count(g => g.Rsvp == RsvpStatus.Going);
    var totalGuests = ev.Guests.Count;
    var savedOrders = ev.PreOrders.Count(p => p.IsSaved);
    var openInquiries = ev.KitchenInquiries.Count(i => i.Status == KitchenConfirmationStatus.AwaitingReply);
}

<div class="max-w-7xl mx-auto px-6 py-8">
    <!-- Event Main Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-4">
        <div>
            <div class="text-[11px] font-bold tracking-wider text-[#738078] uppercase mb-1">
                @ev.Title.ToUpper() / THU, OCT 22, 2026
            </div>
            <h1 class="text-3xl font-bold text-[#233D32] tracking-tight">
                @ev.Title
            </h1>
            <p class="text-xs text-[#738078] mt-1">
                @ev.VenueName · Thu, Oct 22 at 7:00 PM PT · @ev.TableInfo
            </p>
        </div>
        <div>
            <a href="events/create" class="inline-flex items-center gap-2 px-4 py-2 border border-[#D5D3C4] bg-white hover:bg-neutral-50 text-[#233D32] text-xs font-semibold rounded-xl shadow-xs transition">
                <svg class="w-3.5 h-3.5 text-[#738078]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"/></svg>
                <span>Edit event</span>
            </a>
        </div>
    </div>

    <!-- Sub Navigation Tabs -->
    <EventTabs ActiveTab="overview" />

    <!-- 4 Metric Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
        <MetricCard Label="RSVPs" Value="@($"{confirmedGuests} / {totalGuests}")" Subtitle="Everyone has confirmed" IconType="users" />
        <MetricCard Label="Pre-orders" Value="@($"{savedOrders} / {totalGuests}")" Subtitle="Saved · Editable until Oct 20, 5 PM" IconType="orders" />
        <MetricCard Label="Dietary profiles" Value="@($"{totalGuests} / {totalGuests}")" Subtitle="1 allergy · 3 dietary preferences" IconType="leaf" />
        <MetricCard Label="Estimated total" Value="@($"${fin.TotalAmount:0.00}")" Subtitle="Food + 8% tax + 20% tip" IconType="receipt" />
    </div>

    <!-- Alert Banner -->
    @if (openInquiries > 0)
    {
        <div class="p-4 bg-[#FFF8EC] border border-[#F6D8A6] rounded-xl text-xs text-[#945900] mb-6 flex items-start gap-3">
            <svg class="w-4 h-4 text-[#945900] shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
            <div>
                <span class="font-bold">The group is ready. The kitchen still needs to confirm @openInquiries details.</span>
                Alex's shellfish cross-contact precautions and Jordan's low-sodium preparation are unresolved. The order ticket remains a draft.
            </div>
        </div>
    }

    <!-- 2 Column Layout -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-8">
        <!-- Left: Table of Six (2 cols) -->
        <div class="lg:col-span-2 bg-white rounded-2xl border border-[#E3E1D5] p-6 shadow-xs flex flex-col justify-between">
            <div>
                <div class="flex items-center justify-between mb-4">
                    <div>
                        <h2 class="text-base font-bold text-[#233D32]">Your table of @ev.Guests.Count</h2>
                        <p class="text-xs text-[#738078]">@confirmedGuests of @totalGuests RSVPs confirmed · All pre-orders tracked.</p>
                    </div>
                    <button type="button" @onclick="() => isManageGuestsModalOpen = true" class="px-3 py-1.5 border border-[#D5D3C4] rounded-lg text-xs font-semibold text-[#233D32] hover:bg-neutral-50 transition shadow-xs">
                        Manage guests
                    </button>
                </div>

                <div class="overflow-x-auto">
                    <table class="w-full text-xs text-left">
                        <thead>
                            <tr class="text-[10px] uppercase font-bold text-[#738078] border-b border-[#E8E7DF]">
                                <th class="pb-3 font-bold">Guest</th>
                                <th class="pb-3 font-bold">Dietary Profile</th>
                                <th class="pb-3 font-bold">RSVP</th>
                                <th class="pb-3 font-bold text-right">Pre-order</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-[#E8E7DF]">
                            @foreach (var guest in ev.Guests)
                            {
                                var preOrder = ev.PreOrders.FirstOrDefault(p => p.GuestId == guest.Id);
                                <tr class="hover:bg-[#FAF9F5] transition">
                                    <td class="py-3.5 pr-2">
                                        <div class="flex items-center gap-2.5">
                                            <div class="w-7 h-7 rounded-full bg-[#E9F0E9] text-[#244E3B] font-semibold text-xs flex items-center justify-center shrink-0">
                                                @guest.Initials
                                            </div>
                                            <div>
                                                <div class="font-semibold text-[#233D32]">
                                                    @guest.Name
                                                    @if (guest.IsHost)
                                                    {
                                                        <span class="text-[10px] text-[#738078] font-normal ml-1">Host</span>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="py-3.5 px-2">
                                        @if (guest.DietaryProfile.HasAllergies)
                                        {
                                            <div>
                                                <div class="text-[#BC3A2B] font-medium">@guest.DietaryProfile.Summary</div>
                                                <div class="text-[10px] text-[#945900] font-semibold">Kitchen reply needed</div>
                                            </div>
                                        }
                                        else if (guest.DietaryProfile.HasPreferences)
                                        {
                                            <div>
                                                <div class="text-[#233D32]">@guest.DietaryProfile.Summary</div>
                                                @if (guest.Name.Contains("Jordan"))
                                                {
                                                    <div class="text-[10px] text-[#945900] font-semibold">Kitchen reply needed</div>
                                                }
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-[#738078]">No restrictions</span>
                                        }
                                    </td>
                                    <td class="py-3.5 px-2">
                                        <span class="inline-block px-2.5 py-0.5 rounded-full text-[11px] font-medium bg-[#EAF5EE] text-[#247847]">
                                            Going
                                        </span>
                                    </td>
                                    <td class="py-3.5 pl-2 text-right">
                                        <span class="inline-block px-2.5 py-0.5 rounded-full text-[11px] font-medium bg-[#EDECE6] text-[#5A6860]">
                                            Saved
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Table Footer -->
            <div class="pt-4 mt-4 border-t border-[#E8E7DF] text-xs text-[#738078] flex items-center gap-2">
                <svg class="w-4 h-4 text-[#738078]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/></svg>
                <span>6 mains + 2 shared sides · $@fin.FoodSubtotal.ToString("0.00") food subtotal</span>
            </div>
        </div>

        <!-- Right: Keep in loop & Checklist (1 col) -->
        <div class="space-y-6">
            <!-- Shareable Link Card -->
            <div class="bg-white rounded-2xl border border-[#E3E1D5] p-6 shadow-xs">
                <h3 class="text-sm font-bold text-[#233D32] mb-1">Keep everyone in the loop</h3>
                <p class="text-xs text-[#738078] mb-4">Your private invitation link lets guests update their details and choices.</p>

                <div class="p-2.5 bg-[#F7F6F0] rounded-xl border border-[#E3E1D5] text-xs font-mono text-[#233D32] mb-3 flex items-center gap-2">
                    <svg class="w-3.5 h-3.5 text-[#738078]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"/></svg>
                    <span class="truncate">@ev.InviteUrl</span>
                </div>

                <button @onclick="CopyLink" class="w-full py-2.5 rounded-xl border border-[#D5D3C4] text-xs font-semibold text-[#233D32] hover:bg-neutral-50 transition flex items-center justify-center gap-1.5 mb-4">
                    <svg class="w-3.5 h-3.5 text-[#738078]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
                    <span>@copyButtonText</span>
                </button>

                <div class="text-[11px] text-[#738078] flex items-center gap-1.5 pt-3 border-t border-[#E8E7DF]">
                    <svg class="w-3.5 h-3.5 text-[#738078]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10" stroke-width="2"/><path d="M12 6v6l4 2" stroke-width="2"/></svg>
                    <span>Orders close tomorrow · Tue, Oct 20 · 5:00 PM PT</span>
                </div>
            </div>

            <!-- Before You Send Checklist -->
            <div class="bg-white rounded-2xl border border-[#E3E1D5] p-6 shadow-xs">
                <h3 class="text-sm font-bold text-[#233D32] mb-4">Before you send the ticket</h3>

                <div class="space-y-3 mb-6 text-xs text-[#233D32]">
                    <div class="flex items-center gap-2.5">
                        <span class="w-5 h-5 rounded-full bg-[#EAF5EE] text-[#247847] flex items-center justify-center text-[10px] font-bold">✓</span>
                        <span>Collect guest RSVPs</span>
                    </div>
                    <div class="flex items-center gap-2.5">
                        <span class="w-5 h-5 rounded-full bg-[#EAF5EE] text-[#247847] flex items-center justify-center text-[10px] font-bold">✓</span>
                        <span>Collect all 6 pre-orders</span>
                    </div>
                    <div class="flex items-center gap-2.5">
                        <span class="w-5 h-5 rounded-full border border-amber-500 text-amber-600 flex items-center justify-center text-[10px] font-bold">!</span>
                        <span class="font-medium text-amber-900">Resolve @openInquiries kitchen questions</span>
                    </div>
                    <div class="flex items-center gap-2.5 text-[#738078]">
                        <span class="w-5 h-5 rounded-full border border-[#D5D3C4] flex items-center justify-center text-[10px]">○</span>
                        <span>Send the final order ticket</span>
                    </div>
                </div>

                <a href="events/studio-team-dinner/matrix" class="w-full py-3 bg-[#244E3B] hover:bg-[#1B3D2E] text-white text-xs font-semibold rounded-xl shadow-xs transition flex items-center justify-center gap-1.5">
                    <span>Review dietary matrix</span>
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
                </a>
            </div>
        </div>
    </div>

    <!-- Bottom Activity Strip -->
    <div class="p-4 bg-[#F0EFE5] rounded-xl border border-[#E3E1D5] text-xs text-[#233D32] flex items-center gap-2.5">
        <svg class="w-4 h-4 text-[#244E3B]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
        <span class="font-semibold text-[#738078]">Latest activity</span>
        <span>Leo saved his citrus salmon pre-order.</span>
        <span class="text-[#738078]">Today, 9:24 AM</span>
    </div>

    <!-- Manage Guests Modal -->
    <ManageGuestsModal @bind-IsOpen="isManageGuestsModalOpen" />
</div>

@code {
    [Parameter] public string? Id { get; set; }

    private string copyButtonText = "Copy invitation link";
    private bool isManageGuestsModalOpen = false;

    protected override void OnInitialized()
    {
        DiningService.OnChange += StateHasChanged;
    }

    public void Dispose()
    {
        DiningService.OnChange -= StateHasChanged;
    }

    private async Task CopyLink()
    {
        copyButtonText = "Copied to clipboard!";
        StateHasChanged();
        await Task.Delay(2000);
        copyButtonText = "Copy invitation link";
        StateHasChanged();
    }
}


