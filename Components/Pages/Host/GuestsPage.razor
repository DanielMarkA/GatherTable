@page "/guests"
@inject DiningCoordinatorService DiningService
@implements IDisposable

<div class="max-w-7xl mx-auto px-6 py-8">
    <div class="mb-6">
        <div class="text-[11px] font-bold tracking-wider text-[#738078] uppercase mb-1">
            GATHERTABLE / DIRECTORY
        </div>
        <h1 class="text-3xl font-bold text-[#233D32] tracking-tight">
            Guest directory
        </h1>
        <p class="text-xs text-[#738078] mt-1">
            Active team members, dietary constraints, and allergen profiles.
        </p>
    </div>

    <div class="bg-white rounded-2xl border border-[#E3E1D5] shadow-xs overflow-hidden">
        <div class="p-6 border-b border-[#E8E7DF] flex flex-wrap items-center justify-between gap-3">
            <div>
                <h2 class="text-base font-bold text-[#233D32]">Studio team members (@DiningService.CurrentEvent.Guests.Count)</h2>
                <p class="text-xs text-[#738078]">RSVPs, dietary restrictions, and kitchen notes</p>
            </div>
            <div class="flex items-center gap-3">
                <button type="button" @onclick="() => isManageOpen = true" class="px-3.5 py-1.5 bg-[#244E3B] hover:bg-[#1B3D2E] text-white text-xs font-semibold rounded-xl transition shadow-xs flex items-center gap-1.5">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
                    <span>Manage / Add guests</span>
                </button>
                <a href="events/studio-team-dinner/matrix" class="text-xs font-semibold text-[#244E3B] hover:underline">
                    View Dietary Matrix →
                </a>
            </div>
        </div>

        <div class="divide-y divide-[#E8E7DF]">
            @foreach (var g in DiningService.CurrentEvent.Guests)
            {
                <div class="p-4 flex items-center justify-between hover:bg-[#FAF9F5] transition">
                    <div class="flex items-center gap-3">
                        <div class="w-9 h-9 rounded-full bg-[#E9F0E9] text-[#244E3B] font-semibold text-xs flex items-center justify-center">
                            @g.Initials
                        </div>
                        <div>
                            <div class="text-xs font-bold text-[#233D32]">
                                @g.Name
                                @if (g.IsHost)
                                {
                                    <span class="text-[10px] text-[#738078] font-normal ml-1">Host</span>
                                }
                            </div>
                            <div class="text-[11px] text-[#738078]">@g.Email</div>
                        </div>
                    </div>

                    <div class="text-right">
                        <div class="text-xs font-medium @(g.DietaryProfile.HasSevereAllergy ? "text-[#BC3A2B] font-bold" : "text-[#233D32]")">
                            @g.DietaryProfile.Summary
                        </div>
                        <div class="text-[10px] text-[#738078]">
                            @g.Rsvp.ToString()
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

    <ManageGuestsModal @bind-IsOpen="isManageOpen" />
</div>

@code {
    private bool isManageOpen = false;

    protected override void OnInitialized()
    {
        DiningService.OnChange += StateHasChanged;
    }

    public void Dispose()
    {
        DiningService.OnChange -= StateHasChanged;
    }
}


