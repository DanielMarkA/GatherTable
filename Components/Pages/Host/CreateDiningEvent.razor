@page "/events/create"
@inject NavigationManager Navigation
@inject DiningCoordinatorService DiningService

<div class="max-w-7xl mx-auto px-6 py-8">
    <!-- Header Section -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
        <div>
            <div class="text-[11px] font-bold tracking-wider text-[#738078] uppercase mb-1">
                GATHERTABLE / HOST WORKSPACE
            </div>
            <h1 class="text-3xl font-bold text-[#233D32] tracking-tight">
                Bring everyone to the table.
            </h1>
            <p class="text-xs text-[#738078] mt-1">
                Set the details once. Let your guests take it from here.
            </p>
        </div>
        <div class="text-xs text-[#738078] bg-white px-3 py-1.5 rounded-full border border-[#E3E1D5]">
            Draft · Not yet published
        </div>
    </div>

    <!-- Stepper Indicator -->
    <div class="bg-[#F0EFE5] rounded-xl p-3 border border-[#E3E1D5] mb-8 flex items-center justify-around text-xs font-medium text-[#738078]">
        <div class="flex items-center gap-2 text-[#244E3B] font-semibold">
            <span class="w-5 h-5 rounded-full bg-[#244E3B] text-white flex items-center justify-center text-[10px]">✓</span>
            <span>1 Event details</span>
        </div>
        <div class="w-8 h-[1px] bg-[#D5D3C4]"></div>
        <div class="flex items-center gap-2 text-[#244E3B] font-semibold">
            <span class="w-5 h-5 rounded-full border border-[#244E3B] text-[#244E3B] flex items-center justify-center text-[10px]">2</span>
            <span>2 Link a menu</span>
        </div>
        <div class="w-8 h-[1px] bg-[#D5D3C4]"></div>
        <div class="flex items-center gap-2 text-[#738078]">
            <span class="w-5 h-5 rounded-full border border-[#738078] text-[#738078] flex items-center justify-center text-[10px]">3</span>
            <span>3 Invite your guests</span>
        </div>
    </div>

    <!-- Main 2-Column Form Layout -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <!-- Left: Form Fields (2 cols) -->
        <div class="lg:col-span-2 space-y-6">
            <!-- 1. The Essentials -->
            <div class="bg-white rounded-2xl border border-[#E3E1D5] p-6 shadow-xs">
                <div class="mb-5 pb-3 border-b border-[#E8E7DF]">
                    <h2 class="text-base font-bold text-[#233D32]">The essentials</h2>
                    <p class="text-xs text-[#738078]">Give your gathering a name and a place.</p>
                </div>

                <div class="space-y-4">
                    <div>
                        <label class="block text-xs font-semibold text-[#233D32] mb-1.5">Event name *</label>
                        <input type="text" @bind="eventTitle" class="w-full text-xs p-3 rounded-xl border border-[#D5D3C4] focus:outline-none focus:ring-1 focus:ring-[#244E3B] focus:border-[#244E3B] bg-white font-medium text-[#233D32]" />
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <div>
                            <label class="block text-xs font-semibold text-[#233D32] mb-1.5">Date *</label>
                            <input type="text" @bind="eventDateStr" class="w-full text-xs p-3 rounded-xl border border-[#D5D3C4] focus:outline-none focus:ring-1 focus:ring-[#244E3B] focus:border-[#244E3B] bg-white font-medium text-[#233D32]" />
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-[#233D32] mb-1.5">Arrival time *</label>
                            <input type="text" @bind="eventTimeStr" class="w-full text-xs p-3 rounded-xl border border-[#D5D3C4] focus:outline-none focus:ring-1 focus:ring-[#244E3B] focus:border-[#244E3B] bg-white font-medium text-[#233D32]" />
                        </div>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <div>
                            <label class="block text-xs font-semibold text-[#233D32] mb-1.5">Time zone</label>
                            <select @bind="timeZone" class="w-full text-xs p-3 rounded-xl border border-[#D5D3C4] focus:outline-none focus:ring-1 focus:ring-[#244E3B] focus:border-[#244E3B] bg-white font-medium text-[#233D32]">
                                <option>Pacific Time (Los Angeles)</option>
                                <option>Eastern Time (New York)</option>
                                <option>Central Time (Chicago)</option>
                            </select>
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-[#233D32] mb-1.5">Reservation / table</label>
                            <input type="text" @bind="tableInfo" class="w-full text-xs p-3 rounded-xl border border-[#D5D3C4] focus:outline-none focus:ring-1 focus:ring-[#244E3B] focus:border-[#244E3B] bg-white font-medium text-[#233D32]" />
                        </div>
                    </div>

                    <div>
                        <label class="block text-xs font-semibold text-[#233D32] mb-1.5">A note for your guests</label>
                        <textarea @bind="guestNote" rows="3" class="w-full text-xs p-3 rounded-xl border border-[#D5D3C4] focus:outline-none focus:ring-1 focus:ring-[#244E3B] focus:border-[#244E3B] bg-white text-[#233D32] leading-relaxed"></textarea>
                    </div>
                </div>
            </div>

            <!-- 2. Venue & Linked Menu -->
            <div class="bg-white rounded-2xl border border-[#E3E1D5] p-6 shadow-xs">
                <div class="mb-5 pb-3 border-b border-[#E8E7DF]">
                    <h2 class="text-base font-bold text-[#233D32]">Venue & linked menu</h2>
                    <p class="text-xs text-[#738078]">Guests choose from this menu. You stay in control of the final ticket.</p>
                </div>

                <div class="space-y-4">
                    <div class="flex items-center justify-between p-4 bg-[#F7F6F0] rounded-xl border border-[#E3E1D5]">
                        <div class="flex items-center gap-3">
                            <div class="w-10 h-10 rounded-xl bg-white border border-[#E3E1D5] flex items-center justify-center text-[#244E3B]">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>
                            </div>
                            <div>
                                <div class="text-xs font-bold text-[#233D32]">The Juniper Room</div>
                                <div class="text-[11px] text-[#738078]">1840 Union St, San Francisco, CA</div>
                            </div>
                        </div>
                        <button class="text-xs font-semibold text-[#244E3B] hover:underline">Change</button>
                    </div>

                    <div>
                        <label class="block text-xs font-semibold text-[#233D32] mb-1.5">Venue menu link *</label>
                        <div class="relative">
                            <span class="absolute left-3 top-3 text-[#738078]">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"/></svg>
                            </span>
                            <input type="text" @bind="menuUrl" class="w-full text-xs pl-9 pr-3 py-3 rounded-xl border border-[#D5D3C4] focus:outline-none focus:ring-1 focus:ring-[#244E3B] focus:border-[#244E3B] bg-white font-medium text-[#233D32]" />
                        </div>
                    </div>

                    <div class="flex items-center gap-2">
                        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[11px] font-semibold bg-[#EAF5EE] text-[#247847]">
                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                            <span>Menu linked · 5 dishes · Prices in USD</span>
                        </span>
                        <span class="px-2.5 py-1 rounded-full text-[11px] bg-[#EDECE6] text-[#5A6860]">
                            Reviewed Oct 19
                        </span>
                    </div>

                    <p class="text-[11px] text-[#738078] leading-relaxed">
                        Ingredient data supports screening, not allergy clearance. Kitchen confirmation is required for cross-contact questions.
                    </p>
                </div>
            </div>

            <!-- 3. Invitations & Ordering -->
            <div class="bg-white rounded-2xl border border-[#E3E1D5] p-6 shadow-xs">
                <div class="mb-5 pb-3 border-b border-[#E8E7DF]">
                    <h2 class="text-base font-bold text-[#233D32]">Invitations & ordering</h2>
                    <p class="text-xs text-[#738078]">A private link for your group. No guest accounts required.</p>
                </div>

                <div class="space-y-4">
                    <div>
                        <label class="block text-xs font-semibold text-[#233D32] mb-1.5">Invite by email</label>
                        <div class="relative">
                            <span class="absolute left-3 top-3 text-[#738078]">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                            </span>
                            <input type="text" @bind="invitedEmails" class="w-full text-xs pl-9 pr-3 py-3 rounded-xl border border-[#D5D3C4] focus:outline-none focus:ring-1 focus:ring-[#244E3B] focus:border-[#244E3B] bg-white font-medium text-[#233D32]" />
                        </div>
                        <div class="text-[11px] text-[#738078] mt-1.5">
                            5 invitations ready · Maya Chen is included as the host (6 guests total).
                        </div>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <div>
                            <label class="block text-xs font-semibold text-[#233D32] mb-1.5">Pre-order deadline *</label>
                            <input type="text" @bind="deadlineStr" class="w-full text-xs p-3 rounded-xl border border-[#D5D3C4] focus:outline-none focus:ring-1 focus:ring-[#244E3B] focus:border-[#244E3B] bg-white font-medium text-[#233D32]" />
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-[#233D32] mb-1.5">Reminder</label>
                            <input type="text" value="24 hours before the deadline" readonly class="w-full text-xs p-3 rounded-xl border border-[#D5D3C4] bg-[#F7F6F0] text-[#738078]" />
                        </div>
                    </div>

                    <label class="flex items-center gap-2.5 cursor-pointer pt-2">
                        <input type="checkbox" checked class="w-4 h-4 rounded text-[#244E3B] focus:ring-[#244E3B] accent-[#244E3B]" />
                        <span class="text-xs text-[#233D32]">Allow guests to update choices until the deadline</span>
                    </label>
                </div>
            </div>
        </div>

        <!-- Right: Live Preview & Financial Settings (1 col) -->
        <div class="space-y-6">
            <!-- Guests Live Mobile Preview Card -->
            <div class="bg-[#244E3B] text-white rounded-2xl p-6 shadow-md">
                <div class="text-[10px] font-bold tracking-wider uppercase text-white/70 mb-4">
                    YOUR GUESTS WILL SEE
                </div>

                <div class="w-8 h-8 rounded-full bg-white/10 flex items-center justify-center text-white mb-4">
                    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M18 2v6a3 3 0 0 1-3 3 3 3 0 0 1-3-3V2"/>
                        <path d="M15 2v14"/>
                        <path d="M6 2v20"/>
                        <path d="M4 2v4a2 2 0 0 0 4 0V2"/>
                    </svg>
                </div>

                <h3 class="text-xl font-bold tracking-tight mb-1">
                    @eventTitle
                </h3>
                <p class="text-xs text-white/80 mb-5 pb-4 border-b border-white/20">
                    You're invited by Maya Chen
                </p>

                <div class="space-y-2 text-xs text-white/90 mb-6">
                    <div class="font-semibold">The Juniper Room</div>
                    <div>Thu, Oct 22 · 7:00 PM PT</div>
                    <div class="text-white/70">@tableInfo</div>
                </div>

                <a href="j/studio-oct22" class="w-full py-3 bg-white text-[#244E3B] font-semibold text-xs rounded-xl shadow-xs transition hover:bg-neutral-100 flex items-center justify-center">
                    Join the table
                </a>
            </div>

            <!-- Tax & Tip Setting Card -->
            <div class="bg-white rounded-2xl border border-[#E3E1D5] p-6 shadow-xs">
                <h3 class="text-sm font-bold text-[#233D32] mb-1">A clear bill, from the start</h3>
                <p class="text-xs text-[#738078] mb-4">Shared dishes and financial allocations are calculated automatically.</p>

                <div class="space-y-3 mb-4">
                    <div>
                        <label class="block text-[11px] font-semibold text-[#738078] mb-1">Sales tax</label>
                        <input type="text" @bind="salesTax" class="w-full text-xs p-2.5 rounded-lg border border-[#D5D3C4] bg-white text-[#233D32]" />
                    </div>
                    <div>
                        <label class="block text-[11px] font-semibold text-[#738078] mb-1">Tip</label>
                        <input type="text" @bind="tip" class="w-full text-xs p-2.5 rounded-lg border border-[#D5D3C4] bg-white text-[#233D32]" />
                    </div>
                </div>

                <p class="text-[11px] text-[#738078] leading-relaxed">
                    Shared dishes are split evenly across all 6 guests. Tax and tip follow each person's food total, including their share.
                </p>
            </div>

            <!-- Ready Alert Box -->
            <div class="p-4 bg-[#EAF5EE] border border-[#CCE7D5] rounded-xl flex items-start gap-2.5 text-xs text-[#247847]">
                <svg class="w-4 h-4 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                <div>
                    <div class="font-bold">Ready to create</div>
                    <div class="text-[11px] text-[#247847]/90 mt-0.5">
                        All required fields are complete. Invitations will only be sent when you create the event.
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Bottom Actions Bar -->
    <div class="mt-8 pt-4 border-t border-[#E8E7DF] flex items-center justify-between">
        <span class="text-xs text-[#738078]">Draft saved just now</span>
        <div class="flex items-center gap-3">
            <button @onclick="SaveDraft" class="px-5 py-2.5 rounded-xl text-xs font-medium border border-[#D5D3C4] bg-white text-[#233D32] hover:bg-neutral-50 transition">
                Save draft
            </button>
            <button @onclick="CreateAndSend" class="px-5 py-2.5 rounded-xl text-xs font-semibold bg-[#244E3B] text-white hover:bg-[#1B3D2E] transition flex items-center gap-2 shadow-xs">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/></svg>
                <span>Create & send 5 invitations</span>
            </button>
        </div>
    </div>
</div>

@code {
    private string eventTitle = "Studio team dinner";
    private string eventDateStr = "Thu, October 22, 2026";
    private string eventTimeStr = "7:00 PM";
    private string timeZone = "Pacific Time (Los Angeles)";
    private string tableInfo = "Garden table · 6 guests";
    private string guestNote = "A little time away from our screens. Join us for a relaxed team dinner — choose something you'll love before we arrive.";
    private string menuUrl = "juniperroom.example/menus/dinner";
    private string invitedEmails = "alex@studio.co, jordan@studio.co, sam@studio.co, priya@studio.co, leo@studio.co";
    private string deadlineStr = "Tue, Oct 20, 2026 · 5:00 PM";
    private string salesTax = "8% of food subtotal";
    private string tip = "20% of food subtotal";

    private void SaveDraft()
    {
        Navigation.NavigateTo("events/studio-team-dinner");
    }

    private void CreateAndSend()
    {
        DiningService.CurrentEvent.Title = eventTitle;
        DiningService.CurrentEvent.Status = EventStatus.Active;
        Navigation.NavigateTo("events/studio-team-dinner");
    }
}

