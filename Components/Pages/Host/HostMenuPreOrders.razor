@page "/menu"
@page "/events/studio-team-dinner/menu"
@page "/events/{id}/menu"
@inject NavigationManager Navigation
@inject DiningCoordinatorService DiningService
@inject Supabase.Client Db
@using static Supabase.Postgrest.Constants
@implements IDisposable

@{
    var ev = DiningService.CurrentEvent;
}

<div class="max-w-7xl mx-auto px-6 py-8">
    <!-- Header Section -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-4">
        <div>
            <div class="text-[11px] font-bold tracking-wider text-[#738078] uppercase mb-1">
                @ev.Title.ToUpper() / THU, OCT 22, 2026
            </div>
            <h1 class="text-3xl font-bold text-[#233D32] tracking-tight">
                Good choices, all in one place.
            </h1>
            <p class="text-xs text-[#738078] mt-1">
                Dinner menu · @ev.VenueName · Linked & actively synchronized
            </p>
        </div>
        <div class="flex items-center gap-2">
            <button type="button" @onclick="OpenAddModal" class="inline-flex items-center gap-1.5 px-3.5 py-2 bg-[#244E3B] hover:bg-[#1B3D2E] text-white text-xs font-semibold rounded-xl shadow-xs transition">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
                <span>Add dish</span>
            </button>
            <button type="button" @onclick="LoadDishesFromSupabase" disabled="@isDbLoading" class="inline-flex items-center gap-2 px-3.5 py-2 border border-[#D5D3C4] bg-white hover:bg-neutral-50 text-[#233D32] text-xs font-semibold rounded-xl shadow-xs transition disabled:opacity-50">
                <svg class="w-3.5 h-3.5 text-[#738078] @(isDbLoading ? "animate-spin" : "")" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
                <span>@(isDbLoading ? "Refreshing..." : "Refresh")</span>
            </button>
        </div>
    </div>

    <!-- Sub Navigation Tabs -->
    <EventTabs ActiveTab="menu" />

    <!-- Filters & View Mode Bar -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-6 text-xs">
        <div class="flex flex-wrap items-center gap-2">
            <!-- Active vs Archived Catalog View -->
            <div class="inline-flex bg-[#EAE8DD] p-0.5 rounded-full border border-[#D5D3C4] mr-2">
                <button type="button" @onclick="() => SetViewMode(false)" class="px-3 py-1 rounded-full font-semibold transition text-xs @(!showArchived ? "bg-[#233D32] text-white shadow-xs" : "text-[#5A6860] hover:text-[#233D32]")">
                    Active (@activeCount)
                </button>
                <button type="button" @onclick="() => SetViewMode(true)" class="px-3 py-1 rounded-full font-semibold transition text-xs @(showArchived ? "bg-[#233D32] text-white shadow-xs" : "text-[#5A6860] hover:text-[#233D32]")">
                    Archived (@archivedCount)
                </button>
            </div>

            <!-- Dietary Tag Filters -->
            @if (!showArchived)
            {
                <button type="button" @onclick='() => activeMenuFilter = "all"' class="px-3 py-1 rounded-full font-medium transition @(activeMenuFilter == "all" ? "bg-[#233D32] text-white" : "bg-white text-[#738078] border border-[#E3E1D5] hover:bg-neutral-50")">
                    All
                </button>
                <button type="button" @onclick='() => activeMenuFilter = "vegetarian"' class="px-3 py-1 rounded-full font-medium transition @(activeMenuFilter == "vegetarian" ? "bg-[#233D32] text-white" : "bg-white text-[#738078] border border-[#E3E1D5] hover:bg-neutral-50")">
                    Vegetarian
                </button>
                <button type="button" @onclick='() => activeMenuFilter = "no-shellfish"' class="px-3 py-1 rounded-full font-medium transition @(activeMenuFilter == "no-shellfish" ? "bg-[#233D32] text-white" : "bg-white text-[#738078] border border-[#E3E1D5] hover:bg-neutral-50")">
                    Hide shellfish
                </button>
            }
        </div>

        <div class="text-[11px] text-[#738078] font-medium">
            @if (showArchived)
            {
                <span>Archived dishes retain history and can be restored at any time</span>
            }
            else
            {
                <span>@DisplayedDishes.Count() dishes displayed</span>
            }
        </div>
    </div>

    <!-- Active Dishes Grid -->
    @if (!showArchived)
    {
        @if (!DisplayedDishes.Any())
        {
            <div class="bg-white rounded-2xl border border-[#E3E1D5] p-12 text-center my-6">
                <div class="w-12 h-12 rounded-full bg-[#E9F0E9] text-[#244E3B] flex items-center justify-center mx-auto mb-3">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg>
                </div>
                <h3 class="text-sm font-bold text-[#233D32] mb-1">No active dishes found</h3>
                <p class="text-xs text-[#738078] mb-4">Add a new dish or check the Archived tab to restore previously deleted items.</p>
                <button type="button" @onclick="OpenAddModal" class="px-4 py-2 bg-[#244E3B] text-white text-xs font-semibold rounded-xl hover:bg-[#1B3D2E] transition shadow-xs">
                    Add dish
                </button>
            </div>
        }
        else
        {
            <!-- Main Courses and Shared Sides -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
                @foreach (var dish in DisplayedDishes.Where(d => d.Category != "Appetizer"))
                {
                    var isCurrentActive = selectedDish?.Id == dish.Id;
                    var selections = ev.PreOrders.Where(p => p.MenuItemId == dish.Id).ToList();

                    <div class="bg-white rounded-2xl border @(isCurrentActive ? "border-[#244E3B] ring-1 ring-[#244E3B]" : "border-[#E3E1D5]") shadow-xs overflow-hidden hover:border-[#244E3B] transition flex flex-col justify-between">
                        <div class="cursor-pointer" @onclick="() => SelectDish(dish)">
                            <div class="h-44 bg-cover bg-center" style="background-image: url('@(string.IsNullOrWhiteSpace(dish.ImageUrl) ? "https://images.unsplash.com/photo-1546069901-ba9599a7e63c?w=600&auto=format&fit=crop&q=80" : dish.ImageUrl)');"></div>
                            <div class="p-5 pb-3">
                                <div class="flex items-start justify-between mb-1.5">
                                    <h3 class="text-base font-bold text-[#233D32]">@dish.Name</h3>
                                    <span class="text-base font-bold text-[#233D32]">$@dish.Price.ToString("0.00")</span>
                                </div>
                                <p class="text-xs text-[#738078] mb-3 leading-relaxed">@dish.Description</p>

                                <div class="flex flex-wrap items-center gap-1.5 mb-2">
                                    @foreach (var allergen in dish.DeclaredAllergens)
                                    {
                                        <span class="px-2 py-0.5 rounded text-[10px] font-semibold bg-[#FFF8EC] text-[#945900]">
                                            Contains @allergen
                                        </span>
                                    }
                                    @if (dish.DeclaredAllergens.Count == 0)
                                    {
                                        <span class="px-2 py-0.5 rounded text-[10px] font-semibold bg-[#EAF5EE] text-[#247847]">
                                            No major declared allergens
                                        </span>
                                    }
                                </div>
                            </div>
                        </div>

                        <!-- Action Bar: Edit, Pre-orders & Delete -->
                        <div class="p-4 pt-3 border-t border-[#E8E7DF] flex items-center justify-between gap-2 bg-[#FAF9F5]">
                            <div class="text-[11px] text-[#738078]">
                                @if (dish.IsSharedDish)
                                {
                                    <span class="font-medium text-[#244E3B]">Shared dish</span>
                                }
                                else
                                {
                                    <span>@selections.Count pre-ordered</span>
                                }
                            </div>

                            <div class="flex items-center gap-2">
                                <button type="button" @onclick="() => OpenEditModal(dish)" class="px-3 py-1.5 text-xs font-semibold text-[#244E3B] hover:bg-[#E9F0E9] border border-[#C5D9CC] rounded-xl transition flex items-center gap-1">
                                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
                                    <span>Edit</span>
                                </button>
                                <button type="button" @onclick="() => SoftDeleteDish(dish)" class="px-3 py-1.5 text-xs font-semibold text-[#BC3A2B] hover:bg-red-50 border border-red-200 rounded-xl transition flex items-center gap-1">
                                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                                    <span>Delete</span>
                                </button>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <!-- Appetizers Catalog -->
            @foreach (var dish in DisplayedDishes.Where(d => d.Category == "Appetizer"))
            {
                <div class="bg-white rounded-xl border border-[#E3E1D5] p-4 shadow-xs flex items-center justify-between mb-6 hover:border-[#244E3B] transition">
                    <div class="flex items-center gap-3 cursor-pointer" @onclick="() => SelectDish(dish)">
                        <div class="w-10 h-10 rounded-lg bg-[#FAF9F5] border border-[#E3E1D5] flex items-center justify-center text-[#738078]">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg>
                        </div>
                        <div>
                            <div class="text-xs font-bold text-[#233D32]">@dish.Name · $@dish.Price.ToString("0.00")</div>
                            <div class="text-[11px] text-[#738078]">@dish.Description</div>
                        </div>
                    </div>

                    <div class="flex items-center gap-2">
                        <button type="button" @onclick="() => OpenEditModal(dish)" class="px-2.5 py-1 text-xs font-semibold text-[#244E3B] hover:bg-[#E9F0E9] border border-[#C5D9CC] rounded-lg transition">
                            Edit
                        </button>
                        <button type="button" @onclick="() => SoftDeleteDish(dish)" class="px-2.5 py-1 text-xs font-semibold text-[#BC3A2B] hover:bg-red-50 border border-red-200 rounded-lg transition">
                            Delete
                        </button>
                    </div>
                </div>
            }
        }
    }
    else
    {
        <!-- Archived Dishes Section -->
        <div class="space-y-3 mb-8">
            @if (!archivedDishes.Any())
            {
                <div class="bg-white rounded-2xl border border-[#E3E1D5] p-10 text-center">
                    <p class="text-xs text-[#738078]">No archived dishes. Deleted dishes will appear here and can be restored.</p>
                </div>
            }
            @foreach (var dish in archivedDishes)
            {
                <div class="bg-white rounded-xl border border-[#E3E1D5] p-4 shadow-xs flex flex-col sm:flex-row sm:items-center justify-between gap-3 opacity-80 hover:opacity-100 transition">
                    <div>
                        <div class="flex items-center gap-2">
                            <span class="text-xs font-bold text-[#233D32] line-through">@dish.Name</span>
                            <span class="text-xs font-semibold text-[#738078]">$@dish.Price.ToString("0.00")</span>
                            <span class="px-2 py-0.2 rounded text-[10px] font-semibold bg-neutral-100 text-[#738078]">
                                @dish.Category
                            </span>
                        </div>
                        <div class="text-[11px] text-[#738078] mt-0.5">
                            Archived on @dish.DeletedAt?.ToLocalTime().ToString("MMM dd, yyyy h:mm tt")
                        </div>
                    </div>
                    <div>
                        <button type="button" @onclick="() => RestoreDish(dish)" class="px-3 py-1.5 bg-[#244E3B] hover:bg-[#1B3D2E] text-white text-xs font-semibold rounded-xl shadow-xs transition flex items-center gap-1.5">
                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
                            <span>Restore to menu</span>
                        </button>
                    </div>
                </div>
            }
        </div>
    }

    <!-- Guest Pre-orders Section -->
    <div class="bg-white rounded-2xl border border-[#E3E1D5] p-6 shadow-xs mt-8">
        <div class="mb-5 pb-3 border-b border-[#E8E7DF] flex items-center justify-between">
            <div>
                <h2 class="text-base font-bold text-[#233D32]">Guest pre-orders</h2>
                <p class="text-xs text-[#738078]">All 6 saved · Changes remain open until Tue, Oct 20 at 5:00 PM</p>
            </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-6 gap-4">
            @foreach (var guest in ev.Guests)
            {
                var preOrder = ev.PreOrders.FirstOrDefault(p => p.GuestId == guest.Id);
                var dish = preOrder != null ? allLoadedDishes.FirstOrDefault(m => m.Id == preOrder.MenuItemId) : null;
                var dishCost = dish?.Price ?? 0;

                <div class="p-4 bg-[#F7F6F0] rounded-xl border border-[#E3E1D5] flex flex-col justify-between cursor-pointer hover:border-[#244E3B] transition"
                     @onclick="() => OpenGuestDrawer(guest, dish)">
                    <div>
                        <div class="w-7 h-7 rounded-full bg-[#E9F0E9] text-[#244E3B] font-semibold text-xs flex items-center justify-center mb-2">
                            @guest.Initials
                        </div>
                        <div class="text-xs font-bold text-[#233D32] mb-1">@guest.Name</div>
                        <div class="text-xs font-semibold text-[#244E3B] mb-1">
                            @(dish?.Name ?? "No choice yet")
                        </div>
                        <div class="text-[11px] text-[#738078] mb-3 leading-normal">
                            @(preOrder?.SpecialPrepSummary ?? "Standard preparation")
                        </div>
                    </div>

                    <div>
                        <div class="text-xs font-bold text-[#233D32] mb-2">
                            $@dishCost.ToString("0.00") + $4 shared
                        </div>
                        @if (preOrder != null && preOrder.HasKitchenPending)
                        {
                            <span class="inline-block px-2 py-0.5 rounded text-[10px] font-semibold bg-[#FFF8EC] text-[#945900]">
                                Kitchen pending
                            </span>
                        }
                        else
                        {
                            <span class="inline-block px-2 py-0.5 rounded text-[10px] font-semibold bg-[#EDECE6] text-[#5A6860]">
                                Saved
                            </span>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<!-- Slide-over Pre-order Drawer -->
<DishEditDrawer IsOpen="isDrawerOpen" SelectedDish="selectedDish" InitialGuestId="drawerGuestId" OnClose="CloseDrawer" />

<!-- Add Dish Modal -->
@if (isAddModalOpen)
{
    <div class="fixed inset-0 z-50 overflow-y-auto" aria-modal="true" role="dialog">
        <div class="fixed inset-0 bg-black/40 backdrop-blur-xs transition-opacity" @onclick="() => isAddModalOpen = false"></div>
        <div class="flex min-h-full items-center justify-center p-4">
            <div class="relative w-full max-w-lg bg-white rounded-2xl shadow-xl border border-[#E3E1D5] p-6 overflow-hidden">
                <div class="flex items-center justify-between pb-3 mb-4 border-b border-[#E8E7DF]">
                    <h3 class="text-base font-bold text-[#233D32]">Add New Dish</h3>
                    <button type="button" @onclick="() => isAddModalOpen = false" class="text-[#738078] hover:text-[#233D32]">✕</button>
                </div>

                <div class="space-y-3.5 text-xs">
                    <div>
                        <label class="block font-semibold text-[#738078] mb-1">Dish Name *</label>
                        <input @bind="formName" placeholder="e.g. Pan-seared Halibut" class="w-full text-xs rounded-xl border border-[#D5D3C4] px-3 py-2 text-[#233D32] focus:border-[#244E3B] focus:outline-none" />
                    </div>

                    <div class="grid grid-cols-2 gap-3">
                        <div>
                            <label class="block font-semibold text-[#738078] mb-1">Price ($) *</label>
                            <input @bind="formPrice" type="number" step="0.50" min="0" class="w-full text-xs rounded-xl border border-[#D5D3C4] px-3 py-2 text-[#233D32] focus:border-[#244E3B] focus:outline-none" />
                        </div>
                        <div>
                            <label class="block font-semibold text-[#738078] mb-1">Category</label>
                            <select @bind="formCategory" class="w-full text-xs rounded-xl border border-[#D5D3C4] px-3 py-2 text-[#233D32] bg-white focus:border-[#244E3B] focus:outline-none">
                                <option value="Main">Main Course</option>
                                <option value="SharedSide">Shared Side</option>
                                <option value="Appetizer">Appetizer</option>
                            </select>
                        </div>
                    </div>

                    <div>
                        <label class="block font-semibold text-[#738078] mb-1">Description & Ingredients</label>
                        <textarea @bind="formDescription" rows="2" placeholder="Description of the dish and key ingredients" class="w-full text-xs rounded-xl border border-[#D5D3C4] px-3 py-2 text-[#233D32] focus:border-[#244E3B] focus:outline-none"></textarea>
                    </div>

                    <div>
                        <label class="block font-semibold text-[#738078] mb-1">Declared Allergens (comma-separated)</label>
                        <input @bind="formAllergens" placeholder="e.g. dairy, fish, gluten" class="w-full text-xs rounded-xl border border-[#D5D3C4] px-3 py-2 text-[#233D32] focus:border-[#244E3B] focus:outline-none" />
                    </div>
                </div>

                <div class="flex items-center justify-end gap-2 pt-5 mt-4 border-t border-[#E8E7DF]">
                    <button type="button" @onclick="() => isAddModalOpen = false" class="px-4 py-2 border border-[#D5D3C4] rounded-xl text-xs font-semibold text-[#738078] hover:bg-neutral-50">
                        Cancel
                    </button>
                    <button type="button" @onclick="SaveNewDish" disabled="@(isSaving || string.IsNullOrWhiteSpace(formName))" class="px-4 py-2 bg-[#244E3B] hover:bg-[#1B3D2E] text-white text-xs font-semibold rounded-xl shadow-xs transition disabled:opacity-50 flex items-center gap-1.5">
                        @if (isSaving)
                        {
                            <svg class="w-3.5 h-3.5 animate-spin" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
                            <span>Saving...</span>
                        }
                        else
                        {
                            <span>Add Dish</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Edit Dish Modal -->
@if (isEditModalOpen && editingDish != null)
{
    <div class="fixed inset-0 z-50 overflow-y-auto" aria-modal="true" role="dialog">
        <div class="fixed inset-0 bg-black/40 backdrop-blur-xs transition-opacity" @onclick="() => isEditModalOpen = false"></div>
        <div class="flex min-h-full items-center justify-center p-4">
            <div class="relative w-full max-w-lg bg-white rounded-2xl shadow-xl border border-[#E3E1D5] p-6 overflow-hidden">
                <div class="flex items-center justify-between pb-3 mb-4 border-b border-[#E8E7DF]">
                    <div>
                        <div class="text-[10px] font-bold text-[#738078] uppercase tracking-wider">Edit Menu Item</div>
                        <h3 class="text-base font-bold text-[#233D32]">@editingDish.Name</h3>
                    </div>
                    <button type="button" @onclick="() => isEditModalOpen = false" class="text-[#738078] hover:text-[#233D32]">✕</button>
                </div>

                <div class="space-y-3.5 text-xs">
                    <div>
                        <label class="block font-semibold text-[#738078] mb-1">Dish Name *</label>
                        <input @bind="formName" class="w-full text-xs rounded-xl border border-[#D5D3C4] px-3 py-2 text-[#233D32] focus:border-[#244E3B] focus:outline-none" />
                    </div>

                    <div class="grid grid-cols-2 gap-3">
                        <div>
                            <label class="block font-semibold text-[#738078] mb-1">Price ($) *</label>
                            <input @bind="formPrice" type="number" step="0.50" min="0" class="w-full text-xs rounded-xl border border-[#D5D3C4] px-3 py-2 text-[#233D32] focus:border-[#244E3B] focus:outline-none" />
                        </div>
                        <div>
                            <label class="block font-semibold text-[#738078] mb-1">Category</label>
                            <select @bind="formCategory" class="w-full text-xs rounded-xl border border-[#D5D3C4] px-3 py-2 text-[#233D32] bg-white focus:border-[#244E3B] focus:outline-none">
                                <option value="Main">Main Course</option>
                                <option value="SharedSide">Shared Side</option>
                                <option value="Appetizer">Appetizer</option>
                            </select>
                        </div>
                    </div>

                    <div>
                        <label class="block font-semibold text-[#738078] mb-1">Description & Ingredients</label>
                        <textarea @bind="formDescription" rows="2" class="w-full text-xs rounded-xl border border-[#D5D3C4] px-3 py-2 text-[#233D32] focus:border-[#244E3B] focus:outline-none"></textarea>
                    </div>

                    <div>
                        <label class="block font-semibold text-[#738078] mb-1">Declared Allergens (comma-separated)</label>
                        <input @bind="formAllergens" class="w-full text-xs rounded-xl border border-[#D5D3C4] px-3 py-2 text-[#233D32] focus:border-[#244E3B] focus:outline-none" />
                    </div>
                </div>

                <div class="flex items-center justify-end gap-2 pt-5 mt-4 border-t border-[#E8E7DF]">
                    <button type="button" @onclick="() => isEditModalOpen = false" class="px-4 py-2 border border-[#D5D3C4] rounded-xl text-xs font-semibold text-[#738078] hover:bg-neutral-50">
                        Cancel
                    </button>
                    <button type="button" @onclick="SaveEditedDish" disabled="@(isSaving || string.IsNullOrWhiteSpace(formName))" class="px-4 py-2 bg-[#244E3B] hover:bg-[#1B3D2E] text-white text-xs font-semibold rounded-xl shadow-xs transition disabled:opacity-50 flex items-center gap-1.5">
                        @if (isSaving)
                        {
                            <svg class="w-3.5 h-3.5 animate-spin" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
                            <span>Updating...</span>
                        }
                        else
                        {
                            <span>Save Changes</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public string? Id { get; set; }

    private string activeMenuFilter = "all";
    private bool showArchived = false;
    private bool isDrawerOpen = false;
    private MenuItem? selectedDish;
    private string? drawerGuestId;

    // Database state
    private List<MenuItem> activeDishes = new();
    private List<MenuItem> archivedDishes = new();
    private List<MenuItem> allLoadedDishes = new();
    private int activeCount = 0;
    private int archivedCount = 0;
    private bool isDbLoading = false;

    // Modal & Form State
    private bool isAddModalOpen = false;
    private bool isEditModalOpen = false;
    private MenuItem? editingDish;
    private string formName = "";
    private decimal formPrice = 24.00m;
    private string formCategory = "Main";
    private string formDescription = "";
    private string formAllergens = "";
    private bool isSaving = false;

    private IEnumerable<MenuItem> DisplayedDishes
    {
        get
        {
            if (showArchived)
            {
                return archivedDishes;
            }

            IEnumerable<MenuItem> dishes = activeDishes;
            if (activeMenuFilter == "vegetarian")
            {
                dishes = dishes.Where(m => m.Name.Contains("risotto", StringComparison.OrdinalIgnoreCase) || m.Name.Contains("vegetable", StringComparison.OrdinalIgnoreCase));
            }
            else if (activeMenuFilter == "no-shellfish")
            {
                dishes = dishes.Where(m => !m.DeclaredAllergens.Any(a => a.Equals("shellfish", StringComparison.OrdinalIgnoreCase)));
            }
            return dishes;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        DiningService.OnChange += StateHasChanged;
        await LoadDishesFromSupabase();
        selectedDish = activeDishes.FirstOrDefault(m => m.Name.Contains("salmon", StringComparison.OrdinalIgnoreCase)) ?? activeDishes.FirstOrDefault();
    }

    public void Dispose()
    {
        DiningService.OnChange -= StateHasChanged;
    }

    private void SetViewMode(bool archived)
    {
        showArchived = archived;
    }

    // Step 6: Load active dishes (Habit 2: filter in database via deleted_at == null)
    // and load archived dishes
    private async Task LoadDishesFromSupabase()
    {
        isDbLoading = true;
        try
        {
            // Active dishes (Where deleted_at == null, ordered by id, limit 50)
            var activeRes = await Db.From<MenuItem>()
                .Where(p => p.DeletedAt == null)
                .Order(p => p.Id, Ordering.Ascending)
                .Range(0, 49)
                .Get();

            // Archived dishes (Where deleted_at != null)
            var archivedRes = await Db.From<MenuItem>()
                .Where(p => p.DeletedAt != null)
                .Order(p => p.Id, Ordering.Ascending)
                .Get();

            activeDishes = activeRes.Models ?? new();
            archivedDishes = archivedRes.Models ?? new();

            activeCount = activeDishes.Count;
            archivedCount = archivedDishes.Count;

            allLoadedDishes = new List<MenuItem>(activeDishes);
            allLoadedDishes.AddRange(archivedDishes);

            // Synchronize with DiningService so guest pre-orders update seamlessly
            if (activeDishes.Count > 0)
            {
                DiningService.CurrentEvent.Menu = activeDishes;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Supabase] Load: {ex.Message}");
            if (activeDishes.Count == 0)
            {
                activeDishes = DiningService.CurrentEvent.Menu;
                activeCount = activeDishes.Count;
                allLoadedDishes = activeDishes;
            }
        }
        finally
        {
            isDbLoading = false;
            StateHasChanged();
        }
    }

    private void OpenAddModal()
    {
        formName = "";
        formPrice = 24.00m;
        formCategory = "Main";
        formDescription = "";
        formAllergens = "";
        isAddModalOpen = true;
    }

    private void OpenEditModal(MenuItem dish)
    {
        editingDish = dish;
        formName = dish.Name;
        formPrice = dish.Price;
        formCategory = dish.Category;
        formDescription = dish.Description;
        formAllergens = dish.DeclaredAllergensText;
        isEditModalOpen = true;
    }

    // Step 7: Create dish (POST /rest/v1/menu_items)
    private async Task SaveNewDish()
    {
        if (string.IsNullOrWhiteSpace(formName)) return;
        isSaving = true;

        try
        {
            var newItem = new MenuItem
            {
                Name = formName.Trim(),
                Price = formPrice,
                Category = formCategory,
                Description = formDescription.Trim(),
                DeclaredAllergensText = formAllergens.Trim(),
                ImageUrl = formCategory == "Appetizer"
                    ? "https://images.unsplash.com/photo-1541544741938-0af808871cc0?w=600&auto=format&fit=crop&q=80"
                    : formCategory == "SharedSide"
                    ? "https://images.unsplash.com/photo-1540420773420-3366772f4999?w=600&auto=format&fit=crop&q=80"
                    : "https://images.unsplash.com/photo-1546069901-ba9599a7e63c?w=600&auto=format&fit=crop&q=80",
                IngredientsText = formDescription.Trim(),
                CreatedAt = DateTime.UtcNow
            };

            await Db.From<MenuItem>().Insert(newItem);
            isAddModalOpen = false;
            await LoadDishesFromSupabase();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Supabase] Insert error: {ex.Message}");
        }
        finally
        {
            isSaving = false;
            StateHasChanged();
        }
    }

    // Step 8: Update dish (PATCH /rest/v1/menu_items?id=eq.X)
    private async Task SaveEditedDish()
    {
        if (editingDish == null || string.IsNullOrWhiteSpace(formName)) return;
        isSaving = true;

        try
        {
            await Db.From<MenuItem>()
                .Where(x => x.Id == editingDish.Id)
                .Set(x => x.Name, formName.Trim())
                .Set(x => x.Price, formPrice)
                .Set(x => x.Category, formCategory)
                .Set(x => x.Description, formDescription.Trim())
                .Set(x => x.DeclaredAllergensText, formAllergens.Trim())
                .Update();

            isEditModalOpen = false;
            await LoadDishesFromSupabase();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Supabase] Update error: {ex.Message}");
        }
        finally
        {
            isSaving = false;
            StateHasChanged();
        }
    }

    // Step 8: Soft delete dish (PATCH /rest/v1/menu_items?id=eq.X setting deleted_at = now())
    private async Task SoftDeleteDish(MenuItem dish)
    {
        try
        {
            await Db.From<MenuItem>()
                .Where(x => x.Id == dish.Id)
                .Set(x => x.DeletedAt!, DateTime.UtcNow)
                .Update();

            await LoadDishesFromSupabase();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Supabase] Soft delete error: {ex.Message}");
        }
    }

    // Restore archived dish (PATCH /rest/v1/menu_items?id=eq.X setting deleted_at = null)
    private async Task RestoreDish(MenuItem dish)
    {
        try
        {
            await Db.From<MenuItem>()
                .Where(x => x.Id == dish.Id)
                .Set(x => x.DeletedAt!, null)
                .Update();

            await LoadDishesFromSupabase();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Supabase] Restore error: {ex.Message}");
        }
    }

    private void SelectDish(MenuItem dish)
    {
        selectedDish = dish;
        drawerGuestId = "guest-alex";
        isDrawerOpen = true;
    }

    private void OpenGuestDrawer(Guest guest, MenuItem? dish)
    {
        selectedDish = dish ?? activeDishes.FirstOrDefault();
        drawerGuestId = guest.Id;
        isDrawerOpen = true;
    }

    private void CloseDrawer()
    {
        isDrawerOpen = false;
    }
}
