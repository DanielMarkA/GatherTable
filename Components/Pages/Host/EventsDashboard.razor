@page "/"
@page "/events"
@inject NavigationManager Navigation
@inject DiningCoordinatorService DiningService
@implements IDisposable

<div class="max-w-7xl mx-auto px-6 py-8">
    <!-- Header Section -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-8">
        <div>
            <div class="text-[11px] font-bold tracking-wider text-[#738078] uppercase mb-1">
                GATHERTABLE / HOST WORKSPACE
            </div>
            <h1 class="text-3xl font-bold text-[#233D32] tracking-tight">
                Good food. Great company.
            </h1>
            <p class="text-xs text-[#738078] mt-1">
                Your next gathering, with every detail in its place.
            </p>
        </div>
        <div>
            <a href="events/create" class="inline-flex items-center gap-2 px-4 py-2.5 bg-[#244E3B] hover:bg-[#1B3D2E] text-white text-xs font-semibold rounded-xl shadow-xs transition">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
                <span>Create event</span>
            </a>
        </div>
    </div>

    <!-- 4 Metric Cards -->
    @{
        var ev = DiningService.CurrentEvent;
        var fin = DiningService.CalculateFinances();
        var confirmedGuests = ev.Guests.Count(g => g.Rsvp == RsvpStatus.Going);
        var totalGuests = ev.Guests.Count;
        var savedOrders = ev.PreOrders.Count(p => p.IsSaved);
        var openQuestions = ev.KitchenInquiries.Count(i => i.Status == KitchenConfirmationStatus.AwaitingReply);
    }
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
        <MetricCard Label="Upcoming events" Value="1" Subtitle="A table to look forward to" IconType="calendar" />
        <MetricCard Label="Guests confirmed" Value="@($"{confirmedGuests} / {totalGuests}")" Subtitle="Everyone is joining the team dinner" IconType="users" />
        <MetricCard Label="Pre-orders saved" Value="@($"{savedOrders} / {totalGuests}")" Subtitle="All choices in · 8 dishes total" IconType="orders" />
        <MetricCard Label="Kitchen confirmations" Value="@($"{openQuestions} open")" Subtitle="Review before sending the ticket" IconType="kitchen" />
    </div>

    <!-- Filter Tabs -->
    <div class="flex items-center justify-between mb-5 border-b border-[#E8E7DF] pb-3 text-xs text-[#738078]">
        <div class="flex items-center gap-3">
            <button class="px-3 py-1.5 rounded-full bg-[#233D32] text-white font-semibold">
                Upcoming · 1
            </button>
            <button class="px-3 py-1.5 rounded-full hover:bg-black/5 text-[#738078] transition">
                Past events
            </button>
        </div>
        <div class="flex items-center gap-1.5 cursor-pointer hover:text-[#233D32]">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7"/></svg>
            <span class="font-medium">List view</span>
        </div>
    </div>

    <!-- Featured Event Hero Card -->
    <div class="bg-[#244E3B] text-white rounded-2xl overflow-hidden shadow-sm mb-8 flex flex-col md:flex-row justify-between">
        <div class="p-8 md:p-10 flex-1 flex flex-col justify-between">
            <div>
                <!-- Status Badges -->
                <div class="flex flex-wrap items-center gap-2 mb-4">
                    <span class="px-3 py-1 rounded-full text-xs font-semibold bg-white text-[#244E3B]">
                        Orders collected
                    </span>
                    <span class="text-[11px] font-semibold text-white/80 uppercase tracking-wider">
                        IN 3 DAYS
                    </span>
                </div>

                <!-- Event Details -->
                <h2 class="text-2xl md:text-3xl font-bold tracking-tight mb-2">
                    @ev.Title
                </h2>
                <div class="flex items-center gap-1.5 text-xs text-white/90 mb-4">
                    <svg class="w-4 h-4 text-white/70" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                    <span>@ev.VenueName · @ev.City</span>
                </div>
                <div class="text-xs text-white/80 space-x-3 mb-6">
                    <span>Thu, Oct 22 · 7:00 PM</span>
                    <span>•</span>
                    <span>@ev.TableInfo</span>
                </div>
            </div>

            <!-- Actions -->
            <div class="flex flex-wrap items-center gap-4">
                <a href="events/studio-team-dinner" class="px-4 py-2.5 bg-white text-[#244E3B] hover:bg-neutral-100 font-semibold text-xs rounded-xl transition flex items-center gap-2 shadow-xs">
                    <span>Open event</span>
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
                </a>

                @if (openQuestions > 0)
                {
                    <a href="events/studio-team-dinner/matrix" class="px-3.5 py-2 rounded-xl text-xs font-medium bg-[#1B3D2E] text-amber-200 border border-amber-300/30 flex items-center gap-2 hover:bg-[#153024] transition">
                        <svg class="w-4 h-4 text-amber-300 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
                        <span>@openQuestions kitchen questions to resolve</span>
                    </a>
                }
            </div>
        </div>

        <!-- Dining Image on Right -->
        <div class="md:w-5/12 bg-cover bg-center min-h-[220px]" style="background-image: url('https://images.unsplash.com/photo-1517248135467-4c7edcad34c4?w=800&auto=format&fit=crop&q=80');">
        </div>
    </div>

    <!-- Bottom Two Columns -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <!-- Left: A few things before dinner (2 cols) -->
        <div class="lg:col-span-2 bg-white rounded-2xl border border-[#E3E1D5] p-6 shadow-xs flex flex-col justify-between">
            <div>
                <div class="mb-4">
                    <h3 class="text-base font-bold text-[#233D32]">A few things before dinner</h3>
                    <p class="text-xs text-[#738078]">Small actions that make the evening run smoothly.</p>
                </div>

                <div class="divide-y divide-[#E8E7DF]">
                    @foreach (var inq in ev.KitchenInquiries)
                    {
                        <div class="py-4 flex items-center justify-between cursor-pointer hover:bg-[#FBFBFA] px-2 rounded-lg transition" @onclick="() => OpenInquiry(inq)">
                            <div class="flex items-start gap-3">
                                <div class="w-8 h-8 rounded-full @(inq.IsSevere ? "bg-[#FDF0ED] text-[#BC3A2B]" : "bg-[#EDECE6] text-[#5A6860]") flex items-center justify-center shrink-0 mt-0.5">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
                                </div>
                                <div>
                                    <div class="text-xs font-semibold text-[#233D32]">
                                        @inq.Title
                                    </div>
                                    <div class="text-[11px] text-[#738078] line-clamp-1 mt-0.5">
                                        @inq.QuestionText
                                    </div>
                                    <div class="mt-1">
                                        <span class="inline-block px-2 py-0.5 rounded text-[10px] font-semibold @(inq.Status == KitchenConfirmationStatus.Confirmed ? "bg-[#EAF5EE] text-[#247847]" : "bg-[#FFF8EC] text-[#945900]")">
                                            @(inq.Status == KitchenConfirmationStatus.Confirmed ? "Confirmed by kitchen" : "Kitchen reply needed")
                                        </span>
                                    </div>
                                </div>
                            </div>
                            <svg class="w-4 h-4 text-[#738078]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                        </div>
                    }
                </div>
            </div>

            <!-- Ordering deadline footer -->
            <div class="pt-4 border-t border-[#E8E7DF] flex items-center gap-2 text-xs text-[#738078]">
                <svg class="w-4 h-4 text-[#738078]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10" stroke-width="2"/><path d="M12 6v6l4 2" stroke-width="2"/></svg>
                <span>Ordering closes Tue, Oct 20 at 5:00 PM</span>
            </div>
        </div>

        <!-- Right: Around the table (1 col) -->
        <div class="bg-white rounded-2xl border border-[#E3E1D5] p-6 shadow-xs flex flex-col justify-between">
            <div>
                <div class="mb-4">
                    <h3 class="text-base font-bold text-[#233D32]">Around the table</h3>
                    <p class="text-xs text-[#738078]">Everyone is coming. Everyone has chosen.</p>
                </div>

                <!-- Guest avatars -->
                <div class="flex items-center gap-2 mb-6">
                    @foreach (var g in ev.Guests)
                    {
                        <div class="w-8 h-8 rounded-full bg-[#E9F0E9] text-[#244E3B] font-semibold text-xs flex items-center justify-center border border-[#DCE6DE]" title="@g.Name (@g.DietaryProfile.Summary)">
                            @g.Initials
                        </div>
                    }
                </div>

                <!-- Financial total -->
                <div class="p-4 bg-[#F7F6F0] rounded-xl border border-[#E8E7DF] mb-6">
                    <div class="text-[11px] text-[#738078] mb-1">Estimated group total</div>
                    <div class="text-2xl font-bold text-[#233D32] tracking-tight">
                        $@fin.TotalAmount.ToString("0.00")
                    </div>
                    <div class="text-[11px] text-[#738078] mt-1">
                        Includes @ev.SalesTaxPercent.ToString("0")% tax and @ev.TipPercent.ToString("0")% tip
                    </div>
                </div>
            </div>

            <!-- Recent activity notification -->
            <div class="flex items-start gap-2.5 text-xs text-[#233D32] pt-4 border-t border-[#E8E7DF]">
                <div class="w-4 h-4 rounded-full bg-[#EAF5EE] text-[#247847] flex items-center justify-center shrink-0 mt-0.5">
                    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                </div>
                <div>
                    <span class="font-medium">Leo saved his pre-order</span>
                    <div class="text-[11px] text-[#738078]">Citrus salmon · Today at 9:24 AM</div>
                </div>
            </div>
        </div>
    </div>
</div>

<KitchenReplyModal IsOpen="isModalOpen" Inquiry="selectedInquiry" OnClose="CloseModal" />

@code {
    private bool isModalOpen = false;
    private KitchenInquiry? selectedInquiry;

    protected override void OnInitialized()
    {
        DiningService.OnChange += StateHasChanged;
    }

    public void Dispose()
    {
        DiningService.OnChange -= StateHasChanged;
    }

    private void OpenInquiry(KitchenInquiry inq)
    {
        selectedInquiry = inq;
        isModalOpen = true;
    }

    private void CloseModal()
    {
        isModalOpen = false;
    }
}

