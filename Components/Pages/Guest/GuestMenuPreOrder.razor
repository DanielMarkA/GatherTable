@page "/j/{code}/menu"
@page "/guest/{guestId}/menu"
@inject NavigationManager Navigation
@inject DiningCoordinatorService DiningService
@implements IDisposable

@{
    var ev = DiningService.CurrentEvent;
    var guest = GetTargetGuest();
    var preOrder = ev.PreOrders.FirstOrDefault(p => p.GuestId == guest?.Id);
    var salmon = ev.Menu.FirstOrDefault(m => m.Name.Contains("salmon", StringComparison.OrdinalIgnoreCase)) ?? ev.Menu.First();
    var sharedVeggies = ev.Menu.FirstOrDefault(m => m.IsSharedDish);
}

<div class="min-h-screen bg-[#F7F6F0] py-8 px-4 flex justify-center text-[#233D32]">
    <div class="max-w-md w-full bg-white rounded-3xl border border-[#E3E1D5] shadow-sm p-6 sm:p-8 flex flex-col justify-between">
        <div>
            <!-- Top App Bar -->
            <div class="flex items-center justify-between pb-4 border-b border-[#E8E7DF] mb-5">
                <div class="flex items-center gap-2">
                    <svg class="w-5 h-5 text-[#244E3B]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M18 2v6a3 3 0 0 1-3 3 3 3 0 0 1-3-3V2"/>
                        <path d="M15 2v14"/>
                        <path d="M6 2v20"/>
                        <path d="M4 2v4a2 2 0 0 0 4 0V2"/>
                    </svg>
                    <span class="font-bold text-sm tracking-tight text-[#233D32]">GatherTable</span>
                </div>
                <span class="px-2.5 py-0.5 rounded-full text-[10px] font-semibold bg-[#EDECE6] text-[#5A6860]">
                    Guest link
                </span>
            </div>

            <!-- Stepper -->
            <div class="flex items-center justify-between text-xs font-semibold text-[#738078] mb-6">
                <a href="@($"j/{Code ?? "studio-oct22"}")" class="text-[#738078] hover:text-[#233D32]">01 Join & dietary profile</a>
                <span class="text-[#244E3B] border-b-2 border-[#244E3B] pb-1">02 Your pre-order</span>
            </div>

            <!-- Title & User Badge -->
            <h1 class="text-2xl font-bold tracking-tight text-[#233D32] mb-1">
                Something you'll love.
            </h1>
            <p class="text-xs text-[#738078] mb-3">@ev.Title · @ev.VenueName</p>

            <div class="flex items-center justify-between mb-5">
                <span class="px-2.5 py-1 rounded-full text-xs font-semibold bg-[#FDF0ED] text-[#BC3A2B]">
                    @(guest?.Name.Split(' ')[0]) · Shellfish allergy
                </span>
                <a href="@($"j/{Code ?? "studio-oct22"}")" class="text-xs font-semibold text-[#244E3B] hover:underline">
                    Edit profile
                </a>
            </div>

            <!-- Shellfish Filter Banner -->
            <div class="p-3 bg-[#EAF5EE] border border-[#CCE7D5] rounded-xl text-xs text-[#247847] flex items-center justify-between mb-6">
                <div class="flex items-center gap-2">
                    <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z"/></svg>
                    <div>
                        <div class="font-bold">Hide shellfish ingredients · On</div>
                        <div class="text-[11px] text-[#247847]/80">Shrimp toast hidden · Cross-contact may remain</div>
                    </div>
                </div>
            </div>

            <!-- Selected Main Dish Card (Citrus Salmon) -->
            <div class="rounded-2xl border-2 border-[#244E3B] overflow-hidden mb-6 shadow-xs">
                <div class="h-44 bg-cover bg-center" style="background-image: url('@salmon.ImageUrl');"></div>
                <div class="p-5">
                    <div class="flex items-start justify-between mb-1.5">
                        <h2 class="text-lg font-bold text-[#233D32]">@salmon.Name</h2>
                        <span class="text-lg font-bold text-[#233D32]">$@salmon.Price.ToString("0.##")</span>
                    </div>
                    <p class="text-xs text-[#738078] mb-3 leading-relaxed">
                        @salmon.Description Contains fish and mustard.
                    </p>

                    <div class="flex items-center gap-1.5 text-xs font-semibold text-[#247847] mb-3">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                        <span>No shellfish listed in ingredients</span>
                    </div>

                    <!-- Cross-contact Warning Box -->
                    <div class="p-3 bg-[#FFF8EC] border border-[#F6D8A6] rounded-xl text-xs text-[#945900] mb-4 flex items-start gap-2.5">
                        <svg class="w-4 h-4 text-[#945900] shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
                        <div class="leading-relaxed">
                            <div class="font-bold">Cross-contact not confirmed</div>
                            The kitchen also prepares shrimp. Maya has asked about separate pans, utensils, oil and preparation space.
                        </div>
                    </div>

                    <div class="flex items-center justify-between pt-3 border-t border-[#E8E7DF]">
                        <span class="px-2.5 py-1 rounded-full text-[11px] font-bold bg-[#EAF5EE] text-[#244E3B]">
                            Your selected main
                        </span>
                        <div class="flex items-center gap-3 bg-[#F7F6F0] border border-[#E3E1D5] rounded-lg px-2.5 py-0.5">
                            <button @onclick="() => { if(qty > 1) qty--; }" class="text-[#738078] hover:text-[#233D32] font-bold text-sm px-1" disabled="@(qty <= 1)">-</button>
                            <span class="text-xs font-bold text-[#233D32]">@qty</span>
                            <button @onclick="() => qty++" class="text-[#738078] hover:text-[#233D32] font-bold text-sm px-1">+</button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Make it Yours Section -->
            <div class="bg-[#FAF9F5] rounded-2xl border border-[#E3E1D5] p-5 mb-6">
                <div class="flex items-center justify-between mb-3">
                    <h3 class="text-xs font-bold text-[#233D32]">Make it yours</h3>
                    <span class="text-[11px] text-[#738078]">No extra charge</span>
                </div>

                <div class="space-y-2 mb-4 text-xs">
                    <label class="flex items-center gap-2 cursor-pointer">
                        <input type="checkbox" @bind="modPan" class="rounded text-[#244E3B] focus:ring-[#244E3B] accent-[#244E3B]" />
                        <span class="font-medium text-[#233D32]">Separate pan & clean utensils</span>
                    </label>
                    <label class="flex items-center gap-2 cursor-pointer">
                        <input type="checkbox" @bind="modArea" class="rounded text-[#244E3B] focus:ring-[#244E3B] accent-[#244E3B]" />
                        <span class="font-medium text-[#233D32]">Separate prep area from shellfish</span>
                    </label>
                </div>

                <div class="mb-3">
                    <label class="block text-[11px] font-semibold text-[#738078] mb-1">Note to the kitchen</label>
                    <textarea @bind="customNote" rows="2" class="w-full text-xs p-2.5 rounded-lg border border-[#D5D3C4] bg-white text-[#233D32]"></textarea>
                </div>

                <div class="text-[11px] text-[#945900] font-medium flex items-center gap-1.5">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10" stroke-width="2"/><path d="M12 6v6l4 2" stroke-width="2"/></svg>
                    <span>Request saved · Not yet confirmed by the kitchen</span>
                </div>
            </div>

            <!-- Other Mains to Explore -->
            <div class="mb-6">
                <span class="text-[10px] font-bold uppercase tracking-wider text-[#738078] block mb-2">Other mains to explore</span>
                <div class="space-y-2">
                    <div class="p-3 bg-white rounded-xl border border-[#E3E1D5] flex items-center justify-between cursor-pointer hover:border-[#244E3B]">
                        <div>
                            <div class="text-xs font-bold text-[#233D32]">Mushroom risotto</div>
                            <div class="text-[10px] text-[#945900]">Cross-contact still needs confirmation</div>
                        </div>
                        <div class="flex items-center gap-2 text-xs font-bold text-[#233D32]">
                            <span>$24</span>
                            <span class="text-[#738078]">›</span>
                        </div>
                    </div>

                    <div class="p-3 bg-white rounded-xl border border-[#E3E1D5] flex items-center justify-between cursor-pointer hover:border-[#244E3B]">
                        <div>
                            <div class="text-xs font-bold text-[#233D32]">Herb-roasted chicken</div>
                            <div class="text-[10px] text-[#945900]">Cross-contact still needs confirmation</div>
                        </div>
                        <div class="flex items-center gap-2 text-xs font-bold text-[#233D32]">
                            <span>$28</span>
                            <span class="text-[#738078]">›</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- For the Table (Shared Dish) -->
            <div class="p-4 bg-[#F0EFE5] rounded-xl border border-[#E3E1D5] mb-6">
                <div class="flex items-center justify-between mb-1">
                    <span class="text-xs font-bold text-[#233D32]">For the table</span>
                    <span class="text-[10px] text-[#738078]">Added by Maya</span>
                </div>
                <div class="text-xs font-semibold text-[#244E3B] mb-1">
                    2 × Roasted vegetables · $24 total
                </div>
                <p class="text-[11px] text-[#738078] leading-relaxed">
                    Split equally between 6 guests: $4.00 each. Alex's portion needs the same cross-contact precautions.
                </p>
            </div>

            <!-- Your Dinner, Untangled (Cost Breakdown) -->
            @{
                var mainCost = salmon.Price * qty;
                var sharedCost = 4.00m;
                var subtotal = mainCost + sharedCost;
                var tax = Math.Round(subtotal * 0.08m, 2);
                var tip = Math.Round(subtotal * 0.20m, 2);
                var guestTotal = subtotal + tax + tip;
            }
            <div class="bg-white rounded-2xl border border-[#E3E1D5] p-5 mb-6">
                <h3 class="text-base font-bold text-[#233D32] mb-3">Your dinner, untangled.</h3>

                <div class="space-y-2 text-xs text-[#233D32] pb-3 border-b border-[#E8E7DF]">
                    <div class="flex justify-between">
                        <span>Citrus salmon × @qty</span>
                        <span class="font-medium">$@mainCost.ToString("0.00")</span>
                    </div>
                    <div class="flex justify-between">
                        <span>Shared vegetables · 1/6</span>
                        <span class="font-medium">$@sharedCost.ToString("0.00")</span>
                    </div>
                </div>

                <div class="space-y-1.5 text-xs text-[#233D32] py-3 border-b border-[#E8E7DF]">
                    <div class="flex justify-between text-[#738078]">
                        <span>Your food subtotal</span>
                        <span>$@subtotal.ToString("0.00")</span>
                    </div>
                    <div class="flex justify-between text-[#738078]">
                        <span>Tax · 8%</span>
                        <span>$@tax.ToString("0.00")</span>
                    </div>
                    <div class="flex justify-between text-[#738078]">
                        <span>Tip · 20% of food</span>
                        <span>$@tip.ToString("0.00")</span>
                    </div>
                </div>

                <div class="flex justify-between items-baseline pt-3">
                    <span class="text-sm font-bold text-[#233D32]">Estimated total</span>
                    <span class="text-2xl font-bold text-[#244E3B]">$@guestTotal.ToString("0.00")</span>
                </div>

                <p class="text-[10px] text-[#738078] mt-2 leading-relaxed">
                    Tax and tip apply to your food plus shared portion. No payment is taken here. Final venue charges may vary.
                </p>
            </div>

            <!-- Saved Alert Banner -->
            <div class="p-3.5 bg-[#FFF8EC] border border-[#F6D8A6] rounded-xl text-xs text-[#945900] mb-6 flex items-start gap-2.5">
                <svg class="w-4 h-4 text-[#945900] shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
                <div class="leading-relaxed">
                    <div class="font-bold">Saved, with a kitchen question open</div>
                    Your choice is recorded, not confirmed allergy-safe. Maya will share the restaurant's response before the order is finalized.
                </div>
            </div>
        </div>

        <!-- Submit Button & Footer -->
        <div class="pt-4 border-t border-[#E8E7DF]">
            <button @onclick="SaveUpdates" class="w-full py-3.5 bg-[#244E3B] hover:bg-[#1B3D2E] text-white font-semibold text-xs rounded-xl shadow-xs transition flex items-center justify-center gap-2 mb-3">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                <span>@saveButtonText</span>
            </button>
            <div class="text-center text-[10px] text-[#738078] space-y-1">
                <div>Pre-order saved · Edit until Oct 20, 5:00 PM PT</div>
                <div class="flex items-center justify-center gap-1">
                    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
                    <span>Private event · No account needed</span>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public string? Code { get; set; }
    [Parameter] public string? GuestId { get; set; }

    private int qty = 1;
    private bool modPan = true;
    private bool modArea = true;
    private string customNote = "Please confirm oil and sauces have no shellfish contact. I carry epinephrine.";
    private string saveButtonText = "Save pre-order updates";

    protected override void OnInitialized()
    {
        var guest = GetTargetGuest();
        if (guest != null)
        {
            var existing = DiningService.CurrentEvent.PreOrders.FirstOrDefault(p => p.GuestId == guest.Id);
            if (existing != null)
            {
                qty = existing.Quantity;
                customNote = existing.KitchenNote;
                modPan = existing.Modifications.Any(m => m.Contains("pan", StringComparison.OrdinalIgnoreCase));
                modArea = existing.Modifications.Any(m => m.Contains("area", StringComparison.OrdinalIgnoreCase));
            }
        }
    }

    public void Dispose()
    {
    }

    private Guest? GetTargetGuest()
    {
        if (!string.IsNullOrEmpty(GuestId))
        {
            return DiningService.CurrentEvent.Guests.FirstOrDefault(g => g.Id == GuestId);
        }
        return DiningService.CurrentEvent.Guests.FirstOrDefault(g => g.Name.Contains("Alex")) ?? DiningService.CurrentEvent.Guests.FirstOrDefault();
    }

    private async Task SaveUpdates()
    {
        var guest = GetTargetGuest();
        var salmon = DiningService.CurrentEvent.Menu.FirstOrDefault(m => m.Name.Contains("salmon", StringComparison.OrdinalIgnoreCase));
        if (guest != null && salmon != null)
        {
            var mods = new List<string>();
            if (modPan) mods.Add("Separate pan & clean utensils");
            if (modArea) mods.Add("Separate prep area from shellfish");

            DiningService.UpdateGuestPreOrder(guest.Id, salmon.Id, qty, mods, customNote);
            saveButtonText = "✓ Saved successfully!";
            StateHasChanged();
            await Task.Delay(2000);
            saveButtonText = "Save pre-order updates";
            StateHasChanged();
        }
    }
}

